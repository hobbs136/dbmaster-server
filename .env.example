# dbmaster-server 真库 e2e 测试环境变量模板。
#
# 复制为 .env（已被 .gitignore 排除，不入库）并按需填写。
# 所有连接参数须指向**自备测试库**——本仓库不携带任何真实部署地址或凭据。
# 任一必需变量缺失时，对应测试打印 `SKIP: <VAR> not set` 并通过（离线恒绿）；
# URL 形态非法则显性 panic（带变量名）。
#
# 注意：.env 仅供人工对照；cargo / python / bash 不会自动加载，
# 运行时请把变量导出到进程环境（示例见各组注释）。

# ── data_sync e2e（tests/e2e_data_sync_test.rs，--ignored 手动跑）──
# 运行：设置全部 DS_E2E_* 后
#   cargo test --test e2e_data_sync_test -- --ignored --nocapture
# URL 中特殊字符须 percent-encode（如密码含 '@' 写作 %40）。
# MySQL 源库连接串（含库名，如 mysql://user:pass@host:3306/dbmaster_e2e）
DS_E2E_MYSQL_URL=
# MySQL 管理连接串（无库名，用于 CREATE DATABASE，如 mysql://user:pass@host:3306/）
DS_E2E_MYSQL_ADMIN_URL=
# PostgreSQL 目标库连接串（如 postgres://user:pass@host:5432/postgres）
DS_E2E_PG_URL=
# ClickHouse HTTP 端点（如 http://host:8123）+ 账号
DS_E2E_CH_BASE=
DS_E2E_CH_USER=
DS_E2E_CH_PASSWORD=
DS_E2E_CH_DB=
# Doris：FE MySQL 协议连接串（DS_E2E_DORIS_MYSQL_URL，当前测试仅作声明）+
# Stream Load BE HTTP 端点与账号（如 host / 8040）
DS_E2E_DORIS_MYSQL_URL=
DS_E2E_DORIS_BE_HOST=
DS_E2E_DORIS_BE_PORT=
DS_E2E_DORIS_USER=
DS_E2E_DORIS_PASSWORD=
DS_E2E_DORIS_DB=

# ── 网络层 / 网关 Redis e2e（crates/automation/src/gw_net_e2e.rs、scripts/e2e_gw_http.py）──
# Redis 密码（主机地址用下方 GW_E2E_REDIS）
GW_E2E_REDIS_PASSWORD=
# GW_E2E_REDIS=host:6379            # Redis 目标（缺失或不可达 = SKIP）
# GW_E2E_SSH=user@host:22           # SSH 跳板（privateKey 认证）；或 user:password@host:22
# GW_E2E_SSH_KEY=/path/to/id_ed25519  # 私钥路径（缺省 ~/.ssh/id_ed25519，须无口令）

# ── scripts/e2e_gw_http.py 附加变量 ──
# GW_E2E_HOST=host                  # 测试库主机（Redis/Mongo/TDengine 共用）
# GW_E2E_MONGO_PASSWORD=...         # MongoDB admin 密码

# ── scripts/e2e_p0.sh ──
# BASE=http://host:13400            # 目标 server 部署地址（必需，缺失 = SKIP）
# ADMIN_TOKEN=...                   # /api/license admin token

# ── 其它既有 env 门控测试（参考，同样自备凭据）──
# QS_E2E_MYSQL_HOST / QS_E2E_MYSQL_PASSWORD        # tests/query_stats_e2e_test.rs
# NC_E2E_MYSQL_HOST / NC_E2E_MYSQL_PASSWORD        # tests/native_collector_e2e_test.rs
# NC_E2E_REDIS_HOST / NC_E2E_REDIS_PASSWORD
# GW_E2E_TDENGINE_HOST / GW_E2E_TDENGINE_PASSWORD  # crates/gateway/tests/gw_tdengine.rs
